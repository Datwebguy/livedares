PORT=3000
OPENAI_API_KEY=
TWITCH_CHANNEL=
TWITCH_BOT_USERNAME=
TWITCH_OAUTH=oauth:
# Optional; defaults to ./data/challenges.sqlite
# DATABASE_PATH=./data/challenges.sqlite

# Optional Twitch application client ID, for live game context.
TWITCH_CLIENT_ID=
# Optional Twitch application client secret, for live game context.
TWITCH_CLIENT_SECRET=
# Optional number of trusted reverse proxy hops; defaults to Railway detection or zero locally.
TRUST_PROXY=
