PORT=3000
OPENAI_API_KEY=
TWITCH_CHANNEL=
TWITCH_BOT_USERNAME=
TWITCH_OAUTH=oauth:
# Optional; defaults to ./data/challenges.sqlite
# DATABASE_PATH=./data/challenges.sqlite

# Optional but recommended once the app is online: a password for the dashboard buttons.
# Viewers can still watch; only people with the password can mark dares done, start the queue or change the theme.
# ADMIN_TOKEN=
